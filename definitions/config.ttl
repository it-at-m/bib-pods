@prefix bp:   <https://www.muenchner-stadtbibliothek.de/bib-pods#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

bp:config
    bp:solrEndpoint <https://bib-pods.ngrok.dev/solr/interim-index/select> ;
    bp:mainPath "/bib-pods" ;
    bp:solidPodSuggestion <https://solidcommunity.net/>, <https://start.inrupt.com/profile> .

<https://solidcommunity.net/>      rdfs:label "solidcommunity.net" .
<https://start.inrupt.com/profile> rdfs:label "Inrupt PodSpaces" .
