@prefix cori:    <https://cori.systems/core#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

# ----- Interactions -----

cori:UserAction a rdfs:Class ;
    rdfs:label "interaction pattern"@en, "Interaktionsmuster"@de .

# =================================================================================
# Profile — terms stored in a user's profile graph, validated by profile.shapes.ttl
# =================================================================================

cori:Profile a rdfs:Class ;
    rdfs:label "profile"@en, "Profil"@de .

cori:username a rdf:Property ;
    rdfs:label "username"@en, "Benutzername"@de ;
    rdfs:domain cori:Profile ;
    rdfs:range xsd:string ;
    cori:inSection cori:PersonalSection ;
    cori:order 10 .

cori:comment a rdf:Property ;
    rdfs:label "comment"@en, "Kommentar"@de ;
    rdfs:domain cori:Profile ;
    rdfs:range xsd:string ;
    cori:inSection cori:PersonalSection ;
    cori:order 20 ;
    cori:assistantQuestion false . # a free-form remark, not something to prompt for

# =================================================================================
# Profile sections — thematic groups of profile fields, the basis for the profile UI
# =================================================================================

# A "profile field" is any property with rdfs:domain cori:Profile — that domain
# triple attaches the field to the profile root. Fields and sections may come from
# any registered vocabulary; getVocab() merges them all into one graph.

cori:ProfileSection a rdfs:Class ;
    rdfs:label "profile section"@en, "Profilbereich"@de .

cori:inSection a rdf:Property ;
    rdfs:label "in section"@en ;
    rdfs:domain rdf:Property ;
    rdfs:range cori:ProfileSection ;
    rdfs:comment "The section a profile field is displayed under. Fields without a section render in a generic catch-all." .

cori:order a rdf:Property ;
    rdfs:range xsd:integer ;
    rdfs:comment "Display order among siblings: sections within the profile, fields within their section. Lower comes first." .

cori:EmptySectionsBlock cori:order 100 ;
    rdfs:comment "UI anchor, not a section: where the profile UI's 'still empty sections' disclosure sorts among the sections. Sections with a higher cori:order render below the disclosure." .

cori:pluralLabel a rdf:Property ;
    rdfs:comment "Plural form of rdfs:label, used where the UI titles a group of values of this property." .

cori:assistantQuestion a rdf:Property ;
    rdfs:domain rdf:Property ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Whether the dialog assistant asks about this profile field. false = the field's values arrive through dedicated interactions (e.g. catalogue clicks) or the field doesn't suit a guided question (free-form remarks). Unset counts as true." .

# ----- Closed value sets for profile fields -----

cori:allowedValues a rdf:Property ;
    rdfs:domain rdf:Property ;
    rdfs:range skos:ConceptScheme ;
    rdfs:comment "Closed value set for a profile field: a skos:ConceptScheme whose skos:hasTopConcept concepts are the choices on offer (German skos:prefLabel = display text). The dialog assistant renders a picker instead of a free-text input for such fields. Value-set schemes come from the consuming app's registered vocabularies, e.g. snapshots extracted from a catalogue index. A skos:definition on the scheme (German preferred) is surfaced next to the picker as provenance help: where do these values come from." .

cori:StorageForm a rdfs:Class .
cori:LabelLiteral a cori:StorageForm .
cori:ConceptIri a cori:StorageForm .

cori:storeAs a rdf:Property ;
    rdfs:domain rdf:Property ;
    rdfs:range cori:StorageForm ;
    rdfs:comment "How a picked allowed-value concept lands in the profile: cori:LabelLiteral stores the concept's label as a plain string (for fields matched label-first against an index whose values carry no authority IRIs), cori:ConceptIri stores the concept IRI plus an rdfs:label triple. Unset counts as cori:LabelLiteral." .

# ----- Generic sections -----

cori:PersonalSection a cori:ProfileSection ;
    rdfs:label "personal"@en, "Persönliches"@de ;
    cori:order 10 .

cori:Message a rdfs:Class ;
    rdfs:label "message" ;
    rdfs:comment "A recommendation or notification shown to the user in the cockpit." .

cori:content a rdf:Property ;
    rdfs:label "content" ;
    rdfs:domain cori:Message ;
    rdfs:range xsd:string .

cori:read a rdf:Property ;
    rdfs:label "read" ;
    rdfs:domain cori:Message ;
    rdfs:range xsd:boolean .

cori:refersToEntity a rdf:Property ;
    rdfs:label "refers to entity" ;
    rdfs:domain cori:Message ;
    rdfs:range xsd:string .

# ----- App configuration -----

cori:appName a rdf:Property ;
    rdfs:label "app name"@en ;
    rdfs:comment "Identifies the consuming app: used as localStorage key prefix and as the OIDC client_name on the Solid consent screen." ;
    rdfs:range xsd:string .

cori:profileFilename a rdf:Property ;
    rdfs:label "profile filename"@en ;
    rdfs:comment "Filename used for the user's profile resource inside the cori/ container of their Solid pod." ;
    rdfs:range xsd:string .
