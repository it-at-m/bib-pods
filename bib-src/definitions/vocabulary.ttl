@prefix bp:      <https://www.muenchner-stadtbibliothek.de/bib-pods#> .
@prefix cori:    <https://cori.systems/core#> .
@prefix bf:      <http://id.loc.gov/ontologies/bibframe/> . # https://id.loc.gov/ontologies/bibframe.html
@prefix as:      <https://www.w3.org/ns/activitystreams#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix schema:  <https://schema.org/> .

# Library-domain extensions to the cori meta-vocabulary

# =================================================================================
# Profile — terms stored in a user's profile graph, validated by profile.shapes.ttl
# =================================================================================

bp:nearestLibrary a rdf:Property ;
    rdfs:label "nearest library"@en, "Nächstgelegene Bibliothek"@de ;
    cori:pluralLabel "nearest libraries"@en, "Nächstgelegene Bibliotheken"@de ;
    rdfs:domain cori:Profile ;
    rdfs:range schema:Library ;
    cori:inSection bp:LibrarySection ;
    cori:assistantQuestion false ;
    cori:order 10 .

bp:favoriteWork a rdf:Property ;
    rdfs:label "favorite work"@en, "Lieblingsbuch"@de ;
    cori:pluralLabel "favorite works"@en, "Lieblingsbücher"@de ;
    rdfs:domain cori:Profile ;
    rdfs:range bf:Work ;
    cori:inSection bp:TasteSection ;
    cori:order 30 ;
    cori:assistantQuestion false . # free text no strategy reads; a liked book goes in through „Titel hinzufügen“

bp:favoriteAuthor a rdf:Property ;
    rdfs:label "favorite author"@en, "Autor*in"@de ;
    cori:pluralLabel "favorite authors"@en, "Autor*innen"@de ;
    rdfs:domain cori:Profile ;
    rdfs:range bf:Person ;
    cori:inSection bp:TasteSection ;
    cori:order 10 ;
    bp:explanationPhrase "dir {value} gefällt"@de ;
    cori:assistantPrompt "Welche Autor*innen liest du gern?"@de ;
    # the catalogue's own "Nachname, Vorname" form — the typed "Cornelia Funke" matches nothing
    cori:assistantExample "Nachname, Vorname – z. B. Funke, Cornelia"@de ;
    bp:linkedToIndex [
        bp:labelField "author" ;
        bp:iriField "author_uri_str_mv"
    ], [
        bp:labelField "author2" ;
        bp:iriField "author2_uri_str_mv"
    ] .

bp:favoriteGenre a rdf:Property ;
    rdfs:label "favorite genre"@en, "Genre"@de ;
    cori:pluralLabel "favorite genres"@en, "Genres"@de ;
    rdfs:domain cori:Profile ;
    rdfs:range bf:GenreForm ;
    cori:inSection bp:TasteSection ;
    cori:order 20 ;
    # Picker values extracted from the catalogue (resources/genre-values.ttl); stored
    # as label literals since the index's genre field carries no authority IRIs.
    cori:allowedValues bp:GenreValues ;
    cori:storeAs cori:LabelLiteral ;
    bp:explanationPhrase "du das Genre {value} magst"@de ;
    cori:assistantPrompt "Welche Arten von Büchern liest du gern?"@de ;
    bp:linkedToIndex [
        bp:labelField "genre" ;
        bp:iriField "genre_uri_str_mv"
    ] .

bp:interestedIn a rdf:Property ;
    rdfs:label "interested in"@en, "Thema"@de ;
    cori:pluralLabel "topics"@en, "Themen"@de ;
    rdfs:domain cori:Profile ;
    rdfs:range bf:Topic ;
    cori:inSection bp:TasteSection ;
    cori:order 40 ;
    bp:explanationPhrase "du dich für {value} interessierst"@de ;
    cori:assistantPrompt "Welche Themen interessieren dich?"@de ;
    # one topic per entry, in the singular of the catalogue's subject headings ("Pferd", not "Pferde")
    cori:assistantExample "ein Thema, z. B. Fotografie"@de ;
    bp:linkedToIndex [
        bp:labelField "topic" ;
        bp:iriField "topic_uri_str_mv"
    ] .

# Backed by the index's geographic subjects (651): small coverage but cleanly
# GND-linked — see interim-index/field-notes.md §4. Covers travel guides as well
# as history/politics/art *about* a place.
bp:interestedInPlace a rdf:Property ;
    rdfs:label "place of interest"@en, "Ort/Region"@de ;
    cori:pluralLabel "places of interest"@en, "Orte & Regionen"@de ;
    rdfs:domain cori:Profile ;
    rdfs:range bf:Place ;
    cori:inSection bp:TasteSection ;
    cori:order 50 ;
    # Picker values extracted from the catalogue (resources/place-values.ttl); stored
    # as label literals to match the index's geographic labels directly.
    cori:allowedValues bp:PlaceValues ;
    cori:storeAs cori:LabelLiteral ;
    bp:explanationPhrase "es um {value} geht"@de ;
    cori:assistantPrompt "Über welche Orte oder Regionen liest du gern?"@de ;
    bp:linkedToIndex [
        bp:labelField "geographic" ;
        bp:iriField "geographic_uri_str_mv"
    ] .

# The index stores ISO 639-2/B codes ("ger"), so the picker concepts display German
# names and carry the code as bp:indexValue; the profile keeps the concept IRI.
# A preference, not a taste: typed bp:RecommendationFilter, it narrows every Solr
# lane instead of forming one of its own.
bp:preferredLanguage a rdf:Property, bp:RecommendationFilter ;
    rdfs:label "preferred language"@en, "Sprache"@de ;
    cori:pluralLabel "preferred languages"@en, "Sprachen"@de ;
    rdfs:domain cori:Profile ;
    rdfs:range bf:Language ;
    cori:inSection bp:LanguagesSection ;
    cori:order 10 ;
    cori:allowedValues bp:LanguageValues ;
    cori:storeAs cori:ConceptIri ;
    bp:explanationPhrase "es auf {value} erschienen ist"@de ;
    cori:assistantPrompt "In welchen Sprachen möchtest du lesen?"@de ;
    bp:linkedToIndex [
        bp:labelField "language"
    ] .

# Media types are catalogue jargon ("Druckschrift"), so the picker concepts carry
# user labels plus the raw token(s) as bp:indexValue — combo values like "Buch + CD"
# fold into their base medium. Also a filter, not a lane (see bp:preferredLanguage).
bp:preferredMedium a rdf:Property, bp:RecommendationFilter ;
    rdfs:label "preferred medium"@en, "Medienart"@de ;
    cori:pluralLabel "preferred media"@en, "Medienarten"@de ;
    rdfs:domain cori:Profile ;
    rdfs:range bf:Carrier ;
    cori:inSection bp:TasteSection ;
    cori:order 60 ;
    cori:allowedValues bp:MediumValues ;
    cori:storeAs cori:ConceptIri ;
    bp:explanationPhrase "es als {value} vorliegt"@de ;
    cori:assistantPrompt "Welche Medienarten bevorzugst du?"@de ;
    bp:linkedToIndex [
        bp:labelField "format"
    ] .

bp:savedBook a rdf:Property, bp:RecommendationExclusion ; # SOPAC identifier
    rdfs:label "saved book"@en, "Gemerktes Buch"@de ;
    cori:pluralLabel "saved books"@en, "Gemerkte Bücher"@de ;
    rdfs:domain cori:Profile ;
    rdfs:range xsd:string ;
    cori:inSection bp:SavedSection ;
    cori:order 10 ;
    cori:assistantQuestion false ; # values are catalogue ids — the Merkliste grows via book interactions, not typed input
    bp:explanationPhrase "es deinen gemerkten Büchern ähnelt"@de .

bp:hobby a rdf:Property ;
    rdfs:label "hobby"@en, "Hobby"@de ;
    cori:pluralLabel "hobbies"@en, "Hobbys"@de ;
    rdfs:domain cori:Profile ;
    rdfs:range xsd:string ;
    cori:inSection bp:HobbiesSection ;
    cori:order 10 ;
    cori:assistantQuestion false . # free text no strategy reads

bp:sourceLabel a rdf:Property .

# German fragment for the "why is this recommended" tooltip; "{value}" (if present) is
# replaced with the matching profile value(s). Fragments are joined by the strategy's
# bp:combine word and prefixed with "Wird empfohlen, weil …".
bp:explanationPhrase a rdf:Property .

# ----- Profile sections -----
# cori:PersonalSection (cori-sdk) opens the profile at cori:order 10; the library
# sections follow. Sections without fields yet are deliberate sketches: they render
# empty and are the attachment points for future fields and dialog assistants.

bp:TasteSection a cori:ProfileSection ;
    rdfs:label "reading taste"@en, "Lesegeschmack"@de ;
    cori:order 20 .

bp:HobbiesSection a cori:ProfileSection ;
    rdfs:label "hobbies"@en, "Hobbys"@de ;
    cori:order 40 .

bp:ProjectsSection a cori:ProfileSection ;
    rdfs:label "projects"@en, "Projekte"@de ;
    cori:order 50 .

bp:LanguagesSection a cori:ProfileSection ;
    rdfs:label "languages"@en, "Sprachen"@de ;
    cori:order 60 .

bp:LibrarySection a cori:ProfileSection ;
    rdfs:label "library"@en, "Bibliothek"@de ;
    cori:order 70 .

# order > cori:EmptySectionsBlock (100): the Merkliste fills itself through catalogue
# clicks rather than curation, so it sits below the "noch leere Bereiche" disclosure.
bp:SavedSection a cori:ProfileSection ;
    rdfs:label "saved list"@en, "Merkliste"@de ;
    cori:order 110 .

# Filled through ✕ in the Schaufenster, so it sits below the disclosure too; folded,
# since it is there to look things up and undo them, not to read every visit.
bp:ExcludedSection a cori:ProfileSection ;
    rdfs:label "not suggested"@en, "Nicht mehr vorschlagen"@de ;
    cori:order 120 ;
    cori:collapsed true ;
    cori:clearable true .

# ----- Index mapping -----

bp:linkedToIndex a rdf:Property .
bp:labelField a rdf:Property .
bp:iriField a rdf:Property .

# On a picker concept: the raw index token(s) it stands for, when they differ from the
# display label ("Deutsch" queries language:"ger"). Several tokens OR into one clause.
bp:excludedBook a rdf:Property, bp:RecommendationExclusion ; # SOPAC identifier
    rdfs:label "excluded book"@en, "Buch"@de ;
    cori:pluralLabel "excluded books"@en, "Bücher"@de ;
    rdfs:domain cori:Profile ;
    rdfs:range xsd:string ;
    cori:inSection bp:ExcludedSection ;
    cori:order 10 ;
    cori:assistantQuestion false .

# Blocklist fields: the values the user doesn't want suggested. Each one negates a
# taste field and shares its index mapping (bp:negates); stored values look like that
# field's, and the profile shows them under „Nicht mehr vorschlagen“.
bp:blockedAuthor a rdf:Property ;
    rdfs:label "blocked author"@en, "Autor*in"@de ;
    cori:pluralLabel "blocked authors"@en, "Autor*innen"@de ;
    rdfs:domain cori:Profile ;
    rdfs:range bf:Person ;
    cori:inSection bp:ExcludedSection ;
    cori:order 20 ;
    cori:assistantQuestion false ;
    bp:negates bp:favoriteAuthor .

bp:blockedGenre a rdf:Property ;
    rdfs:label "blocked genre"@en, "Genre"@de ;
    cori:pluralLabel "blocked genres"@en, "Genres"@de ;
    rdfs:domain cori:Profile ;
    rdfs:range bf:GenreForm ;
    cori:inSection bp:ExcludedSection ;
    cori:order 30 ;
    cori:assistantQuestion false ;
    bp:negates bp:favoriteGenre .

bp:blockedTopic a rdf:Property ;
    rdfs:label "blocked topic"@en, "Thema"@de ;
    cori:pluralLabel "blocked topics"@en, "Themen"@de ;
    rdfs:domain cori:Profile ;
    rdfs:range bf:Topic ;
    cori:inSection bp:ExcludedSection ;
    cori:order 40 ;
    cori:assistantQuestion false ;
    bp:negates bp:interestedIn .

bp:blockedPlace a rdf:Property ;
    rdfs:label "blocked place"@en, "Ort/Region"@de ;
    cori:pluralLabel "blocked places"@en, "Orte & Regionen"@de ;
    rdfs:domain cori:Profile ;
    rdfs:range bf:Place ;
    cori:inSection bp:ExcludedSection ;
    cori:order 50 ;
    cori:assistantQuestion false ;
    bp:negates bp:interestedInPlace .

bp:indexValue a rdf:Property .

# A blocklist field's positive counterpart. Every lane drops books carrying a blocked
# value in that field's index fields.
bp:negates a rdf:Property ;
    rdfs:domain rdf:Property ;
    rdfs:range rdf:Property .

# ----- Interactions -----

bp:followUpQuestion a rdf:Property ;
    rdfs:label "follow-up question"@en ;
    rdfs:domain cori:UserAction ;
    rdfs:range rdf:Property .

# The profile property the action adds the title itself to (its catalogue id), e.g. the
# Merkliste. Its checkbox comes pre-ticked; follow-up questions don't.
bp:addsTitleTo a rdf:Property ;
    rdfs:label "adds title to"@en ;
    rdfs:domain cori:UserAction ;
    rdfs:range rdf:Property .

bp:BookSelection a cori:UserAction ;
    rdfs:label "save a book"@en, "Buch merken"@de ;
    rdfs:comment "„+“ an einer Katalogkarte oder „Titel hinzufügen“ öffnet den Dialog „Was gefällt dir an diesem Buch?“."@de ;
    bp:addsTitleTo bp:savedBook ;
    bp:followUpQuestion bp:favoriteAuthor, bp:favoriteGenre, bp:interestedIn, bp:interestedInPlace .

bp:BookDismissal a cori:UserAction ;
    rdfs:label "dismiss a suggestion"@en, "Nicht mehr vorschlagen"@de ;
    rdfs:comment "✕ an einer Karte im Schaufenster öffnet den Dialog „Was gefällt dir an diesem Buch nicht?“. Angehakte Werte kommen auf die Ausschlussliste; steht einer davon schon in deinem Profil, wird er dort zugleich entfernt."@de ;
    bp:addsTitleTo bp:excludedBook ;
    bp:followUpQuestion bp:blockedAuthor, bp:blockedGenre, bp:blockedTopic, bp:blockedPlace .

# ----- Recommendations -----

bp:RecommendationStrategy a rdfs:Class ;
    rdfs:comment "Legt Engine, Profil-Properties, Verknüpfung, Vorschlagslimit und Standardaktivierung fest. Die gemeinsame Implementierung bestimmt die weitere Auswahl und Reihenfolge; diese sind auf der Strategieseite beschrieben."@de ;
    rdfs:seeAlso <https://it-at-m.github.io/bib-pods/recommendations/> .

# Profile properties typed bp:RecommendationFilter don't form lanes of their own —
# their values narrow every Solr strategy's query as fq clauses: OR within a property,
# AND across properties ("auf Deutsch oder Englisch, und als E-Book"). The inspira
# engine can't be filtered this way, so its lanes ignore these preferences.
bp:RecommendationFilter a rdfs:Class .

# Profile properties typed bp:RecommendationExclusion hold catalogue ids that no lane
# suggests: Solr queries drop them as -id: fq clauses, the inspira lane filters them out.
bp:RecommendationExclusion a rdfs:Class .

bp:usesProfileProperty a rdf:Property ;
    rdfs:domain bp:RecommendationStrategy ;
    rdfs:range rdf:Property .

bp:combine a rdf:Property ;
    rdfs:comment "Verknüpft die Profileinträge für die Suche. Auswahl und Reihenfolge der Vorschläge werden zusätzlich von der jeweiligen Engine bestimmt."@de ;
    rdfs:domain bp:RecommendationStrategy ;
    rdfs:range bp:Combinator .

bp:engine a rdf:Property ; # which backend computes the strategy's results
    rdfs:domain bp:RecommendationStrategy ;
    rdfs:range bp:RecommendationEngine .

bp:maxSuggestions a rdf:Property ; # how many books the strategy's lane shows; default: runner limit (normally 3)
    rdfs:domain bp:RecommendationStrategy ;
    rdfs:range xsd:integer .

bp:RecommendationEngine a rdfs:Class .
bp:SolrEngine a bp:RecommendationEngine ; # Lucene query over the interim index, built from profile facts
    rdfs:label "Solr" .
bp:InspiraEngine a bp:RecommendationEngine ; # inspira_BIB embeddings recommender (Qdrant), seeded from the Merkliste
    rdfs:label "inspira_BIB" .

# How a strategy combines its several profile inputs into one query. Two kinds:
# logical (Boolean join of Solr clauses) vs vector (embedding-space aggregation).
bp:Combinator a rdfs:Class .
bp:LogicalCombinator rdfs:subClassOf bp:Combinator ; rdfs:label "logisch" .
bp:VectorCombinator rdfs:subClassOf bp:Combinator ; rdfs:label "Vektorraum" .

bp:Or a bp:LogicalCombinator ; rdfs:label "OR" .
bp:And a bp:LogicalCombinator ; rdfs:label "AND" .
bp:AverageVector a bp:VectorCombinator ; rdfs:label "average_vector" . # Qdrant: averages the example vectors into one query

# Seed state: strategies with bp:enabledByDefault true are the lanes a fresh
# profile starts with; everything else is opt-in via the strategy toggles
# (absent counts as false).
bp:enabledByDefault a rdf:Property ;
    rdfs:domain bp:RecommendationStrategy ;
    rdfs:range xsd:boolean .

# Explicit per-user choices in the profile's settings, overriding the seed:
# a strategy in bp:enabledStrategy runs, one in bp:disabledStrategy doesn't.
# Only deviations from the seed are stored, so strategies added to the
# vocabulary later keep their declared seed state for existing users.
bp:enabledStrategy a rdf:Property ;
    rdfs:range bp:RecommendationStrategy .
bp:disabledStrategy a rdf:Property ;
    rdfs:range bp:RecommendationStrategy .

bp:authorMatch a bp:RecommendationStrategy ;
    rdfs:label "Mehr von deinen Lieblingsautor*innen"@de ;
    bp:engine bp:SolrEngine ;
    bp:usesProfileProperty bp:favoriteAuthor ;
    bp:combine bp:Or ;
    bp:enabledByDefault true .

bp:authorAndTopic a bp:RecommendationStrategy ;
    rdfs:label "Autor*innen & Themen kombiniert"@de ;
    bp:engine bp:SolrEngine ;
    bp:usesProfileProperty bp:favoriteAuthor, bp:interestedIn ;
    bp:combine bp:And .

# Topics, genres and places share one lane: each value is an alternative input, and
# the selection balances the inputs, so a broad genre takes a fair share rather than
# the whole lane. The topic field is the index's best GND-linked subject substrate;
# genre and geographic matching work label-first (genre carries virtually no
# authority links in the MSB data) — see interim-index/field-notes.md §4.
bp:topicMatch a bp:RecommendationStrategy ;
    rdfs:label "Passend zu deinen Interessen"@de ;
    bp:engine bp:SolrEngine ;
    bp:usesProfileProperty bp:interestedIn, bp:favoriteGenre, bp:interestedInPlace ;
    bp:combine bp:Or ;
    bp:maxSuggestions 6 ;
    bp:enabledByDefault true .

bp:savedBookSimilarity a bp:RecommendationStrategy ;
    rdfs:label "Ähnlich zu gemerkten Büchern"@de ;
    rdfs:comment "Sendet deine Merkliste bei jeder Berechnung des Schaufensters (beim Öffnen der Seite und nach jeder Profiländerung) an einen weiteren Server der Stadt München (inspira_BIB), um ähnliche Titel zu finden."@de ;
    bp:engine bp:InspiraEngine ;
    bp:usesProfileProperty bp:savedBook ;
    bp:combine bp:AverageVector ;
    bp:maxSuggestions 5 ;
    bp:enabledByDefault true .

# =================================================================================
# Provenance generators — the "origin" side of the change log (see cori-sdk/storage/provenance.js)
# =================================================================================

bp:MSBwebapp a as:Application ;
    rdfs:label "bib-pods web app"@en, "Bibliotheks-Pods-Webanwendung"@de ;
    rdfs:comment "The bib-pods widget of the Münchner Stadtbibliothek, wherever it is embedded: the demo pages, the TYPO3 extension on the library website."@en .
