@prefix bp:      <https://www.muenchner-stadtbibliothek.de/bib-pods#> .
@prefix cori:    <https://cori.systems/core#> .
@prefix bf:      <http://id.loc.gov/ontologies/bibframe/> . # https://id.loc.gov/ontologies/bibframe.html
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

# Library-domain extensions to the cori meta-vocabulary

# =================================================================================
# Profile — terms stored in a user's profile graph, validated by profile.shapes.ttl
# =================================================================================

bp:favoriteWork a rdf:Property ;
    rdfs:label "favorite work"@en, "Lieblingsbuch"@de ;
    rdfs:range bf:Work .

bp:favoriteAuthor a rdf:Property ;
    rdfs:label "favorite author"@en, "Autor*in"@de ;
    rdfs:range bf:Person ;
    bp:linkedToIndex [
        bp:labelField "author" ;
        bp:iriField "author_uri_str_mv"
    ], [
        bp:labelField "author2" ;
        bp:iriField "author2_uri_str_mv"
    ] .

bp:favoriteGenre a rdf:Property ;
    rdfs:label "favorite genre"@en, "Genre"@de ;
    rdfs:range bf:GenreForm ;
    bp:linkedToIndex [
        bp:labelField "genre" ;
        bp:iriField "genre_uri_str_mv"
    ] .

bp:interestedIn a rdf:Property ;
    rdfs:label "interested in"@en, "Thema"@de ;
    rdfs:range bf:Topic ;
    bp:linkedToIndex [
        bp:labelField "topic" ;
        bp:iriField "topic_uri_str_mv"
    ] .

bp:savedBook a rdf:Property ; # SOPAC identifier
    rdfs:label "saved book"@en, "Gemerktes Buch"@de ;
    rdfs:range xsd:string .

bp:sourceLabel a rdf:Property .

# ----- Index mapping -----

bp:linkedToIndex a rdf:Property .
bp:labelField a rdf:Property .
bp:iriField a rdf:Property .

# ----- Interactions -----

bp:followUpQuestion a rdf:Property ;
    rdfs:label "follow-up question"@en ;
    rdfs:domain cori:UserAction ;
    rdfs:range rdf:Property .

bp:BookSelection a cori:UserAction ;
    rdfs:label "user clicks on a book --> follow-up questions"@en, "Nutzer*in klickt auf ein Buch - Folgefragen"@de ;
    bp:followUpQuestion bp:favoriteAuthor, bp:favoriteGenre, bp:interestedIn .

# ----- Recommendations -----

bp:RecommendationStrategy a rdfs:Class .

bp:usesProfileProperty a rdf:Property ;
    rdfs:domain bp:RecommendationStrategy ;
    rdfs:range rdf:Property .

bp:combine a rdf:Property ;
    rdfs:domain bp:RecommendationStrategy ;
    rdfs:range bp:Combinator .

bp:Combinator a rdfs:Class .
bp:Or a bp:Combinator ; rdfs:label "OR" .
bp:And a bp:Combinator ; rdfs:label "AND" .

bp:authorMatch a bp:RecommendationStrategy ;
    rdfs:label "Mehr von Lieblingsautor*in"@de ;
    bp:usesProfileProperty bp:favoriteAuthor ;
    bp:combine bp:Or .

bp:authorAndTopic a bp:RecommendationStrategy ;
    rdfs:label "Autor*in & Thema kombiniert"@de ;
    bp:usesProfileProperty bp:favoriteAuthor, bp:interestedIn ;
    bp:combine bp:And .
