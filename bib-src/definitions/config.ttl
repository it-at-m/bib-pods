@prefix cori: <https://cori.systems/core#> .
@prefix bp: <https://www.muenchner-stadtbibliothek.de/bib-pods#> .

bp:config
    cori:appName "bib-pods" ;             # localStorage key prefix + Solid OIDC client name
    cori:profileFilename "bib-pods.ttl" ; # filename of the user's profile resource in their Solid pod
    bp:mainPath "/bib-pods" ;             # consumed at build time; gates whether the bundle mounts on a given host page
    bp:solrEndpoint <https://bib-pods.ngrok.dev/solr/interim-index/select> .
