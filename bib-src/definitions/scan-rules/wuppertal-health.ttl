@prefix bp:   <https://www.muenchner-stadtbibliothek.de/bib-pods#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

bp:wuppertalHealthQuestionnaire a bp:ScanSource ;
    rdfs:label "Wuppertaler Solid-Gesundheitsfragebogen"@de ;
    bp:podPath "solid-health-questionnaire/latest.ttl" ;
    bp:formatDescription "HealthQuestionnaireAssessment aus dem solid-health-questionnaire-Vokabular mit verknüpften Antworten oder Kategorieergebnissen"@de ;
    bp:ruleSet bp:wuppertalHealthRules ;
    bp:recognitionQuery """
PREFIX hq: <https://raw.githubusercontent.com/hoelk-f/solid-health-questionnaire/main/public/vocab.ttl#>

ASK WHERE {
    ?assessment a hq:HealthQuestionnaireAssessment .
    {
        ?assessment hq:hasAnswer ?answer .
        ?answer hq:questionId ?question ; hq:optionId ?option .
    } UNION {
        ?assessment hq:hasCategoryScore ?category .
        ?category hq:categoryId ?categoryId .
    }
}
""" .

# Recognize the known export format, not just a file name or survey label.
# This identifies the data format; it does not authenticate its origin.
bp:wuppertalHealthRules a bp:ScanRuleSet ;
    rdfs:label "Wuppertal: Solid-Gesundheitsfragebogen"@de ;
    bp:scanRule bp:wuppertalQuestionTopics .

# One source-specific extraction query, with declarative field → topic mappings.
# Evidence is separate from the proposed profile facts and is never saved there.
bp:wuppertalQuestionTopics a bp:ScanRule ;
    rdfs:label "Fragebogenangaben → Lesethemen"@de ;
    bp:action bp:Derive ;
    bp:constructQuery """
PREFIX bp:   <https://www.muenchner-stadtbibliothek.de/bib-pods#>
PREFIX cori: <https://cori.systems/core#>
PREFIX hq:   <https://raw.githubusercontent.com/hoelk-f/solid-health-questionnaire/main/public/vocab.ttl#>
PREFIX gnd:  <https://d-nb.info/gnd/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>

CONSTRUCT {
    cori:defaultProfile bp:interestedIn ?topic .
    ?topic rdfs:label ?topicLabel .
    _:evidence a bp:ScanEvidence ;
        bp:profileProperty bp:interestedIn ; bp:profileValue ?topic ;
        bp:sourceField ?question ; bp:sourceFieldLabel ?fieldLabel ;
        bp:sourceValue ?answerText ; bp:sourceNode ?answer .
}
WHERE {
    VALUES (?question ?option ?fieldLabel ?topic ?topicLabel) {
        # Reported activity supplies a reading suggestion; low sport frequency does not.
        ("movement-active-days" "1" "Körperlich aktiv (Tage pro Woche)" gnd:4006311-2 "Bewegung")
        ("movement-active-days" "2" "Körperlich aktiv (Tage pro Woche)" gnd:4006311-2 "Bewegung")
        ("movement-active-days" "3" "Körperlich aktiv (Tage pro Woche)" gnd:4006311-2 "Bewegung")
        ("movement-active-days" "4" "Körperlich aktiv (Tage pro Woche)" gnd:4006311-2 "Bewegung")
        ("movement-active-days" "5" "Körperlich aktiv (Tage pro Woche)" gnd:4006311-2 "Bewegung")
        ("movement-active-days" "6" "Körperlich aktiv (Tage pro Woche)" gnd:4006311-2 "Bewegung")
        ("movement-active-days" "7" "Körperlich aktiv (Tage pro Woche)" gnd:4006311-2 "Bewegung")
        ("nutrition-fruit-vegetables" "yes"    "Täglich mindestens fünf Portionen Obst/Gemüse" gnd:4340678-6 "Gesunde Ernährung")
        ("sleep-difficulties" "yes"            "Schlafschwierigkeiten" gnd:4052580-6 "Schlaf")
    }
    ?assessment a hq:HealthQuestionnaireAssessment ; hq:hasAnswer ?answer .
    ?answer hq:questionId ?question ; hq:optionId ?option .
    OPTIONAL { ?answer schema:text ?de . FILTER(LANGMATCHES(LANG(?de), "de")) }
    OPTIONAL { ?answer schema:text ?plain . FILTER(LANG(?plain) = "") }
    OPTIONAL { ?answer schema:text ?en . FILTER(LANGMATCHES(LANG(?en), "en")) }
    BIND(COALESCE(?de, ?plain, ?en, ?option) AS ?answerText)
}
""" .
