# Snapshot: 2026-11-26, source: https://bib-pods.ngrok.dev/solr/interim-index/select

@prefix bp:   <https://www.muenchner-stadtbibliothek.de/bib-pods#> .
@prefix cori: <https://cori.systems/core#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

bp:AudienceValues a skos:ConceptScheme ;
    skos:prefLabel "Altersgruppen im Katalog"@de ;
    skos:definition "Nach der Altersempfehlung im Katalog („ab 8“). Filme und E-Books tragen keine: Mit „Erwachsene“ bleiben sie dabei, mit einer Altersgruppe für Kinder fallen sie heraus."@de ;
    skos:hasTopConcept
