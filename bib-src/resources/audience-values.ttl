        bp:audience-6-bis-9-Jahre,
        bp:audience-bis-5-Jahre,
        bp:audience-Erwachsene .

bp:audience-Erwachsene a skos:Concept ;
    skos:prefLabel "Erwachsene"@de ;
    bp:indexQuery "(*:* -audience_age:[0 TO 15] -genre:(\"Kinderbuch\" OR \"Bilderbuch\" OR \"Jugendbuch\" OR \"Kindersachbuch\" OR \"Jugendsachbuch\" OR \"Sachbilderbuch\"))" ;
    cori:order 1 . # 1,166,534 records
