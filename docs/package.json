{
    "name": "docs-webapp",
    "type": "module",
    "scripts": {
        "dev": "serve .. -l 5173 --no-clipboard",
        "build": "npm run build:plugin && npm run build:interactions",
        "build:plugin": "vite build --config vite.plugin.config.js",
        "build:interactions": "vite build --config vite.interactions.config.js",
        "build:watch": "npm run build:watch:plugin & npm run build:watch:interactions & wait",
        "build:watch:plugin": "vite build --config vite.plugin.config.js --watch",
        "build:watch:interactions": "vite build --config vite.interactions.config.js --watch"
    },
    "devDependencies": {
        "cori": "file:../cori",
        "force-graph": "1.51.4",
        "serve": "14.2.6",
        "vite": "7.3.3"
    }
}
