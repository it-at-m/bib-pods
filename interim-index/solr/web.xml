<?xml version="1.0" encoding="UTF-8"?>
<!-- Solr's web.xml with CORS support added (Jetty 12 / Solr 10.1) -->
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee" version="6.0" metadata-complete="true">

  <!-- CORS filter (must be before the Solr filters) -->
  <filter>
    <filter-name>cross-origin</filter-name>
    <filter-class>org.eclipse.jetty.ee10.servlets.CrossOriginFilter</filter-class>
    <init-param><param-name>allowedOrigins</param-name><param-value>*</param-value></init-param>
    <init-param><param-name>allowedMethods</param-name><param-value>GET,POST,OPTIONS,HEAD</param-value></init-param>
    <init-param><param-name>allowedHeaders</param-name><param-value>origin,content-type,accept,authorization</param-value></init-param>
  </filter>
  <filter-mapping>
    <filter-name>cross-origin</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>

  <!-- Solr core (copied from the image's default web.xml, do not remove) -->
  <listener>
    <listener-class>org.apache.solr.servlet.CoreContainerProvider</listener-class>
  </listener>

  <filter>
    <filter-name>SolrFilter</filter-name>
    <filter-class>org.apache.solr.servlet.RequiredSolrRequestFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>SolrFilter</filter-name>
    <servlet-name>SolrServlet</servlet-name>
  </filter-mapping>

  <filter>
    <filter-name>RateLimitFilter</filter-name>
    <filter-class>org.apache.solr.servlet.RateLimitFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>RateLimitFilter</filter-name>
    <servlet-name>SolrServlet</servlet-name>
  </filter-mapping>

  <filter>
    <filter-name>TracingFilter</filter-name>
    <filter-class>org.apache.solr.servlet.TracingFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>TracingFilter</filter-name>
    <servlet-name>SolrServlet</servlet-name>
  </filter-mapping>

  <filter>
    <filter-name>AuthenticationFilter</filter-name>
    <filter-class>org.apache.solr.servlet.AuthenticationFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>AuthenticationFilter</filter-name>
    <servlet-name>SolrServlet</servlet-name>
  </filter-mapping>

  <servlet>
    <servlet-name>SolrServlet</servlet-name>
    <servlet-class>org.apache.solr.servlet.SolrServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>SolrServlet</servlet-name>
    <url-pattern>/*</url-pattern>
  </servlet-mapping>

  <!-- Define servlet for static Admin UI resources -->
  <servlet>
    <servlet-name>static</servlet-name>
    <servlet-class>org.eclipse.jetty.ee10.servlet.ResourceServlet</servlet-class>
    <init-param>
      <param-name>pathInfoOnly</param-name>
      <param-value>false</param-value>
    </init-param>
    <init-param>
      <param-name>dirAllowed</param-name>
      <param-value>false</param-value>
    </init-param>
  </servlet>
  <!-- Map static Admin UI resources to the static servlet -->
  <servlet-mapping>
    <servlet-name>static</servlet-name>
    <url-pattern>/partials/*</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>static</servlet-name>
    <url-pattern>/libs/*</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>static</servlet-name>
    <url-pattern>/css/*</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>static</servlet-name>
    <url-pattern>/js/*</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>static</servlet-name>
    <url-pattern>/img/*</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>static</servlet-name>
    <url-pattern>/templates/*</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>static</servlet-name>
    <url-pattern>/ui/*</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>LoadAdminUI</servlet-name>
    <servlet-class>org.apache.solr.servlet.LoadAdminUiServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>LoadAdminUI</servlet-name>
    <url-pattern>/index.html</url-pattern>
  </servlet-mapping>

  <mime-mapping>
    <extension>.xsl</extension>
    <!-- per http://www.w3.org/TR/2006/PR-xslt20-20061121/ -->
    <mime-type>application/xslt+xml</mime-type>
  </mime-mapping>

  <welcome-file-list>
    <welcome-file>index.html</welcome-file>
  </welcome-file-list>

  <!-- Get rid of error message -->
  <security-constraint>
    <web-resource-collection>
      <web-resource-name>Disable TRACE</web-resource-name>
      <url-pattern>/</url-pattern>
      <http-method>TRACE</http-method>
    </web-resource-collection>
    <auth-constraint/>
  </security-constraint>
  <security-constraint>
    <web-resource-collection>
      <web-resource-name>Enable everything but TRACE</web-resource-name>
      <url-pattern>/</url-pattern>
      <http-method-omission>TRACE</http-method-omission>
    </web-resource-collection>
  </security-constraint>

</web-app>
